{
  "name": "cap-leaflet-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "release:local": "npm run clean:next && next build --webpack && node scripts/create-local-release.mjs",
    "release:zip": "npm run release:local && powershell -NoProfile -Command \"$zip='dist/CAP-Leaflet-Editor-win-x64.zip'; if (Test-Path $zip) { Remove-Item $zip -Force }; Compress-Archive -Path 'dist/local-release/CAP-Leaflet-Editor/*' -DestinationPath $zip -Force\"",
    "lint": "eslint",
    "electron-dev": "next dev & sleep 2 && electron .",
    "electron-build": "next build && electron-builder --publish never",
    "electron-start": "node .next/standalone/server.js & sleep 2 && electron .",
    "clean:next": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true}); require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@next/swc-win32-x64-msvc": "16.1.6",
    "@supabase/supabase-js": "^2.95.3",
    "mupdf": "^1.27.0",
    "next": "16.1.6",
    "openai": "^6.26.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^28.0.0",
    "electron-builder": "^25.0.0",
    "electron-is-dev": "^3.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "lightningcss-win32-x64-msvc": "^1.31.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.capleafleteditor.app",
    "productName": "CAP Leaflet Editor",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "next.config.ts",
      "package.json",
      "public/**/*",
      ".next/**/*",
      "main.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
